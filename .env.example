APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./hoa_voice_agent.db
DATABASE_AUTO_CREATE=true
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS=false
OUTBOX_ENABLED=false
# Set true only when the API is the single local outbox process. Production
# runs `hoa_voice_agent.voice.outbox_worker` separately.
OUTBOX_WORKER_IN_PROCESS=false
LOG_LEVEL=INFO

# Set to webhook only when a real operations-integration service is available.
OPERATIONS_MODE=fake
OPERATIONS_WEBHOOK_BASE_URL=
OPERATIONS_WEBHOOK_BEARER_TOKEN=

# Twilio resident SMS and vendor notifications. WhatsApp is the preferred vendor channel.
SMS_MODE=fake
VENDOR_NOTIFICATION_CHANNEL=whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
TWILIO_WHATSAPP_FROM=whatsapp:+15550101000
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_WHATSAPP_WEBHOOK_URL=
TWILIO_VALIDATE_WEBHOOKS=true
# Incoming phone calls require a public HTTPS/WSS endpoint (ngrok is fine for a demo).
# Configure the first URL in your Twilio number's Voice webhook settings.
TWILIO_VOICE_WEBHOOK_URL=
TWILIO_VOICE_STREAM_URL=
TWILIO_VALIDATE_WEBHOOKS=true

# Pipecat browser voice runtime. Required only for `python -m hoa_voice_agent.voice.bot`.
# Select the domain-specific voice workflow before starting the process. HOA is
# the default; hotel uses the separate hotel tables and demo PMS.
VOICE_DOMAIN=hoa
HOTEL_DEMO_HOTEL_ID=40000000-0000-0000-0000-000000000001
# Existing HOA responder configuration. It is not used by the hotel PMS flow.
GROQ_API_KEY=
GROQ_LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=llama-3.3-70b-versatile
# Hotel PMS tool selection and its spoken follow-up only. The application still
# validates tool arguments and remains the only component that can make writes.
HOTEL_LLM_API_KEY=
HOTEL_LLM_BASE_URL=https://api.openai.com/v1
HOTEL_LLM_MODEL=gpt-5.6-luna
HOTEL_LLM_REASONING_EFFORT=none
HOTEL_AUDIT_LOG_PATH=logs/hotel_conversation_audit.jsonl
# `deepgram` uses Nova-3; `deepgram_flux` opts into Flux's model-integrated
# turn detection. Flux uses `DEEPGRAM_FLUX_LANGUAGE_HINTS`, not this language.
VOICE_STT_PROVIDER=deepgram_flux
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=multi
# Keep this empty for an unbiased model comparison. Values are a JSON array.
DEEPGRAM_STT_KEYTERMS=[]
DEEPGRAM_FLUX_STT_MODEL=flux-general-multi
DEEPGRAM_FLUX_LANGUAGE_HINTS=["en","hi"]
# Leave Flux turn controls blank to use Deepgram defaults while benchmarking.
DEEPGRAM_FLUX_EOT_THRESHOLD=
DEEPGRAM_FLUX_EAGER_EOT_THRESHOLD=
DEEPGRAM_FLUX_EOT_TIMEOUT_MS=
NVIDIA_STT_SERVER=grpc.nvcf.nvidia.com:443
# Spoken output provider. Cartesia is the active hotel-demo profile.
VOICE_TTS_PROVIDER=cartesia
# Cartesia Sonic 3.5 provides streaming output. A voice ID selects the accent
# and speaking style; the language controls pronunciation. Leave the two
# override values blank to use the English/Hindi defaults chosen below.
# For another Cartesia language, set BOTH CARTESIA_TTS_VOICE and
# CARTESIA_TTS_LANGUAGE to a matching voice from Cartesia's voice library.
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3.5
CARTESIA_TTS_ENGLISH_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
CARTESIA_TTS_HINDI_VOICE=95d51f79-c397-46f9-b49a-23763d3eaa2d
CARTESIA_TTS_VOICE=
CARTESIA_TTS_LANGUAGE=
CARTESIA_TTS_SPEED=1.05
CARTESIA_TTS_EMOTION=content
# Token mode streams LLM output into Cartesia before the full response is ready.
# Zero disables the extra server-side buffer for the lowest first-audio latency.
CARTESIA_TTS_TEXT_MODE=token
CARTESIA_TTS_MAX_BUFFER_DELAY_MS=120
# Fish S2.1 Pro Free. The Fish adapter uses WebSocket + raw PCM so no MP3
# decode step is added to the live call. Reference IDs come from fish.audio/m/...
FISH_API_KEY=
FISH_TTS_MODEL=s2.1-pro-free
FISH_TTS_REFERENCE_ID=
# Fish's API supports `low`; the installed SDK's type annotation is stale and
# the adapter forwards this request-level value deliberately.
FISH_TTS_LATENCY=low
FISH_TTS_CHUNK_LENGTH=100
FISH_TTS_MIN_CHUNK_LENGTH=0
FISH_TTS_CONDITION_ON_PREVIOUS_CHUNKS=false
FISH_TTS_PRECONNECT=true
FISH_TTS_SAMPLE_RATE=24000
FISH_TTS_SPEED=1.08
FISH_TTS_TEMPERATURE=0.8
FISH_TTS_TOP_P=0.8
FISH_TTS_STYLE=warm, conversational
FISH_TTS_TEXT_MODE=sentence
# Choose the complete voice pipeline before starting a session. Supported
# values are en, hi, and hinglish. The adapter keeps it fixed for the call.
VOICE_DEFAULT_LANGUAGE=hinglish
# Subtle outbound room tone during speech and short pauses. Set false to disable.
VOICE_AMBIENT_ENABLED=true
VOICE_AMBIENT_VOLUME=0.4
# NVIDIA_API_KEY is only needed when VOICE_STT_PROVIDER=nvidia. It is not used
# by the active Luna LLM path.
# NVIDIA_API_KEY=
VOICE_DEMO_CALLER_PHONE=+15550101111
# VAD is language-agnostic; these thresholds preserve softer Hindi/Hinglish speech.
VOICE_VAD_CONFIDENCE=0.55
VOICE_VAD_START_SECS=0.15
# Allow natural pauses inside a sentence before ending the turn.
VOICE_VAD_STOP_SECS=0.2
VOICE_VAD_MIN_VOLUME=0.4
# Increase these values in noisy rooms or with long pauses.
VOICE_TURN_STOP_SECS=0.65
VOICE_INTERIM_TRANSCRIPT_FALLBACK_SECS=0.55
VOICE_USE_SMART_TURN=false
VOICE_SMART_TURN_STOP_SECS=0.55
VOICE_SMART_TURN_CPU_COUNT=1
VOICE_USE_INTERRUPTION_GATE=true
VOICE_INTERRUPT_MIN_WORDS=2
VOICE_LLM_MAX_TOKENS=24
VOICE_ENABLE_TRACING=false
