APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./hoa_voice_agent.db
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS=false
LOG_LEVEL=INFO

# Set to webhook only when a real operations-integration service is available.
OPERATIONS_MODE=fake
OPERATIONS_WEBHOOK_BASE_URL=
OPERATIONS_WEBHOOK_BEARER_TOKEN=

# Twilio resident SMS and vendor notifications. WhatsApp is the preferred vendor channel.
SMS_MODE=fake
VENDOR_NOTIFICATION_CHANNEL=whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
TWILIO_WHATSAPP_FROM=whatsapp:+15550101000
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_WHATSAPP_WEBHOOK_URL=
TWILIO_VALIDATE_WEBHOOKS=true
# Incoming phone calls require a public HTTPS/WSS endpoint (ngrok is fine for a demo).
# Configure the first URL in your Twilio number's Voice webhook settings.
TWILIO_VOICE_WEBHOOK_URL=
TWILIO_VOICE_STREAM_URL=
TWILIO_VALIDATE_WEBHOOKS=true

# Pipecat browser voice runtime. Required only for `python -m hoa_voice_agent.voice.bot`.
NVIDIA_API_KEY=
# Deepgram is the default real-time STT provider. `multi` handles Hindi-English
# code switching; use `hi` for a Hindi-only deployment.
VOICE_STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=multi
NVIDIA_STT_SERVER=grpc.nvcf.nvidia.com:443
# Cartesia Sonic 3.5 provides streaming English/Hindi output. Select the
# language before the call; the voice stays fixed for that session.
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3.5
CARTESIA_TTS_ENGLISH_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
CARTESIA_TTS_HINDI_VOICE=95d51f79-c397-46f9-b49a-23763d3eaa2d
CARTESIA_TTS_SPEED=1.0
CARTESIA_TTS_EMOTION=calm
# Token mode streams LLM output into Cartesia before the full response is ready.
# 250 ms balances time-to-first-audio with natural prosody; use sentence for a
# more conservative, smoother mode.
CARTESIA_TTS_TEXT_MODE=token
CARTESIA_TTS_MAX_BUFFER_DELAY_MS=250
# Choose the spoken language before starting a voice session. It remains fixed
# throughout the call; a transcript can never change the TTS voice.
VOICE_DEFAULT_LANGUAGE=en
NVIDIA_TTS_HINDI_VOICE=Magpie-Multilingual.HI-IN.Sofia
# Optional: set NVIDIA_USE_SSL=true or false only for an explicit TLS override.
NVIDIA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b
VOICE_DEMO_CALLER_PHONE=+15550101111
# Low-latency voice defaults. Increase VOICE_TURN_STOP_SECS to 0.6-0.8 if it interrupts users.
VOICE_VAD_STOP_SECS=0.15
VOICE_TURN_STOP_SECS=0.45
VOICE_LLM_MAX_TOKENS=32
