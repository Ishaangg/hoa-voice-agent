APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./hoa_voice_agent.db
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS=false
LOG_LEVEL=INFO

# Set to webhook only when a real operations-integration service is available.
OPERATIONS_MODE=fake
OPERATIONS_WEBHOOK_BASE_URL=
OPERATIONS_WEBHOOK_BEARER_TOKEN=

# Twilio SMS. Keep SMS_MODE=fake until all values are set with real Twilio credentials.
SMS_MODE=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
# Incoming phone calls require a public HTTPS/WSS endpoint (ngrok is fine for a demo).
# Configure the first URL in your Twilio number's Voice webhook settings.
TWILIO_VOICE_WEBHOOK_URL=
TWILIO_VOICE_STREAM_URL=
TWILIO_VALIDATE_WEBHOOKS=true

# Pipecat browser voice runtime. Required only for `python -m hoa_voice_agent.voice.bot`.
NVIDIA_API_KEY=
# Choose `local_whisper` to avoid NVIDIA hosted ASR and run a compact local model.
VOICE_STT_PROVIDER=nvidia
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
NVIDIA_STT_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_TTS_SERVER=grpc.nvcf.nvidia.com:443
# Built-in expressive Magpie voice. Alternatives include Aria.Happy and Aria.Neutral.
NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Aria.Neutral
# A warmer tone used only for the first spoken greeting of each call.
NVIDIA_TTS_GREETING_VOICE=Magpie-Multilingual.EN-US.Aria.Neutral
# Optional: set NVIDIA_USE_SSL=true or false only for an explicit TLS override.
NVIDIA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b
VOICE_DEMO_CALLER_PHONE=+15550101111
# Low-latency voice defaults. Increase VOICE_TURN_STOP_SECS to 0.8-1.0 if it interrupts users.
VOICE_VAD_STOP_SECS=0.15
VOICE_TURN_STOP_SECS=0.6
VOICE_LLM_MAX_TOKENS=48
